{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/contact-us/",
      "destination": "/#visit",
      "permanent": true
    },
    {
      "source": "/joshs-instagram-feed/",
      "destination": "/josh-poindexter-tattoo-artist-oklahoma-city.html",
      "permanent": true
    },
    {
      "source": "/elementor-662/",
      "destination": "/josh-poindexter-tattoo-artist-oklahoma-city.html",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "verispark.io"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.verispark.io"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
